{
  "name": "nami-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "bin": {
    "nami": "bin/nami.js"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsgo --noEmit",
    "start": "node bin/nami.js",
    "dev": "vp pack --watch",
    "install-engine": "cd .. && go build -o tui/engine/nami-engine ./cmd/nami-engine/",
    "setup": "vp run build && vp run install-engine"
  },
  "dependencies": {
    "cli-highlight": "^2.1.11",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "react-devtools-core": "^7.0.1",
    "silvery": "^0.24.0"
  },
  "overrides": {
    "@chenglou/pretext": "0.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "vite-plus": "^0.3.0"
  }
}
