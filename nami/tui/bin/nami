#!/bin/sh
set -e

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
LAUNCHER_PATH="$SCRIPT_DIR/nami.js"
# Silvery, the TUI renderer, needs Node.js 24 or newer. Older releases cannot
# even parse the launcher bundle, so an older node must not win over bun or deno.
NODE_VERSION_CHECK='process.exit(Number(process.versions.node.split(".")[0]) >= 24 ? 0 : 1)'

if [ ! -f "$LAUNCHER_PATH" ]; then
	echo "nami is partially installed: missing launcher bundle at $LAUNCHER_PATH" >&2
	echo "Reinstall nami or copy nami.js next to the nami wrapper." >&2
	exit 1
fi

if command -v node >/dev/null 2>&1 && node -e "$NODE_VERSION_CHECK" >/dev/null 2>&1; then
	exec node "$LAUNCHER_PATH" "$@"
fi

if command -v bun >/dev/null 2>&1; then
	exec bun "$LAUNCHER_PATH" "$@"
fi

if command -v deno >/dev/null 2>&1; then
	# --allow-run already hands the engine, and so every shell command it runs,
	# the user's full access; narrower flags only break the TUI, which also
	# needs sys, ffi and write access.
	exec deno run -A "$LAUNCHER_PATH" "$@"
fi

echo "nami requires one of these runtimes on PATH: node 24 or newer, bun, deno." >&2
if command -v node >/dev/null 2>&1; then
	echo "The node on PATH is $(node --version 2>/dev/null), which is too old." >&2
fi
exit 1
